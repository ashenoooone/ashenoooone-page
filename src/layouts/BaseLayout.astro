---
import type { Lang } from '../i18n/ui'
import type { ArticleMeta, Crumb } from '../lib/schema'
import interCyrillic from '../assets/fonts/inter-normal-cyrillic.woff2?url'
import interLatin from '../assets/fonts/inter-normal-latin.woff2?url'
import LangHint from '../components/layout/LangHint.astro'
import SiteFooter from '../components/layout/SiteFooter.astro'
import SiteHeader from '../components/layout/SiteHeader.astro'
import Container from '../components/ui/Container.astro'
import { site, siteContent, url } from '../config/site'
import { defaultLang, LANGS, otherLang, stripLang, swapLang, useTranslations } from '../i18n/ui'
import { withExperience } from '../lib/experience'
import { articleSchema, breadcrumbSchema, personSchema } from '../lib/schema'
import '../styles/global.css'

interface Props {
  lang?: Lang
  title?: string
  description?: string
  /** Страницы, существующие только на одном языке (витрина примитивов). */
  translated?: boolean
  /** Заметка блога: меняет og:type и добавляет разметку BlogPosting. */
  article?: ArticleMeta
  /** Служебные страницы, которым нечего делать в выдаче. */
  noindex?: boolean
}

const { lang = defaultLang, title, description, translated = true, article, noindex = false } = Astro.props

const t = useTranslations(lang)
const content = siteContent[lang]

const pageTitle = title ? `${title} · ${content.title}` : content.title
const pageDescription = withExperience(description ?? content.description, lang)

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/'
const bare = stripLang(path)

const altHref = translated ? url(swapLang(bare, otherLang(lang))) : undefined

const origin = Astro.site ?? new URL(Astro.url.origin)
const canonical = new URL(url(path), origin)
const image = new URL(url(content.ogImage), origin)
const alternates = translated ? LANGS.map((code) => ({ code, href: new URL(url(swapLang(bare, code)), origin) })) : []

/**
 * Хлебные крошки собираются из пути: раздел берётся из меню, последний уровень —
 * из заголовка страницы. Главная своей цепочки не получает, ей нечего показывать.
 */
const section = site.nav.find((item) => bare === item.href || bare.startsWith(`${item.href}/`))
const crumbs: Crumb[] =
  bare === '/'
    ? []
    : [
        { name: content.title, url: new URL(url(swapLang('/', lang)), origin).href },
        ...(section ? [{ name: t(section.key), url: new URL(url(swapLang(section.href, lang)), origin).href }] : []),
        ...(title && bare !== section?.href ? [{ name: title, url: canonical.href }] : []),
      ]

const context = { lang, origin, canonical, image }

/** Служебным страницам разметка не нужна: их всё равно не показывают в выдаче. */
const schemas = noindex
  ? []
  : [
      bare === '/' && personSchema(context, pageDescription),
      article && articleSchema(context, { title: title ?? content.title, description: pageDescription, article }),
      crumbs.length > 1 && breadcrumbSchema(crumbs),
    ].filter(Boolean)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    {alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={content.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_GB'} />
    {translated && <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_GB' : 'ru_RU'} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${content.title} — ${content.jobTitle}`} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={(article.updated ?? article.published).toISOString()} />
          <meta property="article:author" content={content.title} />
          {article.keywords && <meta property="article:tag" content={article.keywords} />}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />

    <!-- Основной текстовый шрифт: без preload его находят только после разбора CSS. -->
    <link rel="preload" as="font" type="font/woff2" href={lang === 'ru' ? interCyrillic : interLatin} crossorigin />

    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} />
    <link rel="alternate" type="application/rss+xml" title={content.title} href={url(swapLang('/rss.xml', lang))} />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />)}

    <!-- Применяется до первой отрисовки, чтобы страница не моргнула чужой темой. -->
    <script is:inline>
      const stored = localStorage.getItem('theme')
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.dataset.theme = stored
      }
    </script>

    <script is:inline>
      // Любой явный переход по языку запоминается и гасит подсказку на будущее;
      // делегирование ловит и ссылку в шапке, и ссылку в подсказке.
      document.addEventListener('click', (event) => {
        const link = event.target.closest?.('[data-lang-switch]')
        if (link) {
          localStorage.setItem('lang', link.dataset.langSwitch)
        }
      })
    </script>

    <slot name="head" />
  </head>

  <body>
    <div class="min-h-svh px-5 pb-[var(--page-bottom)] sm:px-8">
      <Container as="main">
        {altHref && <LangHint lang={otherLang(lang)} href={altHref} />}
        <SiteHeader lang={lang} path={bare} switchHref={altHref} />
        <slot />
        <SiteFooter lang={lang} />
      </Container>
    </div>
  </body>
</html>
