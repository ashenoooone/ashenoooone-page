---
import { techIcon } from '../../lib/tech-icons'

interface Props {
  name: string
  class?: string
}

const { name, class: className } = Astro.props
const icon = techIcon(name)
---

{
  icon?.emoji && (
    <span
      aria-hidden="true"
      class:list={[
        'inline-flex size-3.5 flex-none items-center justify-center text-[13px] leading-none',
        'grayscale-100 opacity-60 transition duration-200',
        'group-hover/tech:opacity-100 group-hover/tech:grayscale-0',
        className,
      ]}
    >
      {icon.emoji}
    </span>
  )
}
{
  icon?.path && (
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="currentColor"
      fill-rule={icon.evenOdd ? 'evenodd' : undefined}
      style={`--tech-color: ${icon.color}`}
      class:list={[
        'size-3.5 flex-none text-fg-faint transition-colors duration-200',
        'group-hover/tech:text-(--tech-color)',
        className,
      ]}
    >
      <path d={icon.path} />
    </svg>
  )
}
