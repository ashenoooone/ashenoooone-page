---
import Text from './Text.astro'

interface Props {
  /** Подпись левой колонки, например «работаю», «стек». Без неё колонка остаётся пустой. */
  label?: string
  class?: string
}

const { label, class: className } = Astro.props
---

<div class:list={['grid gap-1 sm:grid-cols-[var(--spacing-label)_1fr] sm:items-baseline sm:gap-x-3.5', className]}>
  {label ? <Text variant="label">{label}</Text> : <div aria-hidden="true" class="hidden sm:block" />}
  <div><slot /></div>
</div>
