---
import Text from './Text.astro'

interface Props {
  value: string
  label: string
  class?: string
}

const { value, label, class: className } = Astro.props
---

<div class:list={['flex flex-col gap-0.5 bg-raised px-[22px] py-5', className]}>
  <Text variant="stat" as="span">{value}</Text>
  <Text variant="meta" as="span">{label}</Text>
</div>
