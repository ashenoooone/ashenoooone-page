---
import NotePage from '../../features/pages/NotePage.astro'
import { getNotes, slugOf } from '../../lib/content'

export async function getStaticPaths() {
  const notes = await getNotes('ru')

  return notes.map((note) => ({
    params: { slug: slugOf(note) },
    props: { note },
  }))
}

const { note } = Astro.props
---

<NotePage lang="ru" note={note} />
