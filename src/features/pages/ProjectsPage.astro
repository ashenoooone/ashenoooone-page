---
import type { Lang } from '../../i18n/ui'
import ListGroup from '../../components/ui/ListGroup.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPage, getProjects } from '../../lib/content'
import ProjectRow from '../projects/ProjectRow.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const page = await getPage('projects', lang)
if (!page) {
  throw new Error(`Missing projects page content for "${lang}"`)
}

const projects = await getProjects(lang)
const products = projects.filter(({ data }) => data.kind === 'product')
---

<BaseLayout lang={lang} title={page.data.title} description={page.data.description}>
  <h1 class="sr-only">{page.data.title}</h1>

  <ListGroup space="none">
    {products.map((project) => <ProjectRow project={project} lang={lang} density="roomy" showHighlights />)}
  </ListGroup>
</BaseLayout>
