---
import type { Lang } from '../../i18n/ui'
import ListGroup from '../../components/ui/ListGroup.astro'
import ListRow from '../../components/ui/ListRow.astro'
import Text from '../../components/ui/Text.astro'
import { PROJECTS } from '../../config/projects'
import { useTranslations } from '../../i18n/ui'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPage } from '../../lib/content'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const t = useTranslations(lang)

const page = await getPage('projects', lang)
if (!page) {
  throw new Error(`Missing projects page content for "${lang}"`)
}
---

<BaseLayout lang={lang} title={page.data.title} description={page.data.description}>
  <h1 class="sr-only">{page.data.title}</h1>
  {page.data.lead && <Text variant="lead">{page.data.lead}</Text>}

  {
    PROJECTS.length === 0 && (
      <Text variant="body" class="pt-block-md">
        {t('projects.empty')}
      </Text>
    )
  }

  {
    PROJECTS.map((group) => (
      <ListGroup label={group.label[lang]} space="md">
        {group.items.map((item) => (
          <ListRow
            title={item.title}
            description={item.description[lang]}
            aside={item.aside[lang]}
            href={item.href}
            accent={group.accent}
          />
        ))}
      </ListGroup>
    ))
  }
</BaseLayout>
