---
import type { Lang } from '../../i18n/ui'
import type { Note } from '../../lib/content'
import DotItem from '../../components/ui/DotItem.astro'
import ListRow from '../../components/ui/ListRow.astro'
import { localeUrl } from '../../config/site'
import { topicAccent, topicLabel } from '../../config/topics'
import { useTranslations } from '../../i18n/ui'
import { slugOf } from '../../lib/content'
import { formatMonthYear, readingMinutes } from '../../lib/format'

interface Props {
  note: Note
  lang: Lang
  /** На главной перечисляются только заголовки. */
  compact?: boolean
}

const { note, lang, compact = false } = Astro.props
const { data } = note

const t = useTranslations(lang)
const meta = `${topicLabel(data.topic, lang)} · ${readingMinutes(note.body ?? '')} ${t('blog.readingTime')}`
---

<ListRow
  title={data.title}
  description={compact ? undefined : data.description}
  aside={formatMonthYear(data.date, lang)}
  href={localeUrl(`/blog/${slugOf(note)}`, lang)}
  accent={topicAccent(data.topic)}
  density={compact ? 'compact' : 'default'}
>
  {
    !compact && (
      <DotItem slot="meta" accent={topicAccent(data.topic)} size="sm" class="font-mono text-meta text-fg-faint">
        {meta}
      </DotItem>
    )
  }
</ListRow>
